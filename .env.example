PORT=3000
MONGO_URI=mongodb://127.0.0.1:27018/secure_notes
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h
# host ports published by docker compose (API, React app)
APP_PORT=3000
FRONTEND_PORT=8080
# MongoDB connection pool of the API (required; read at startup, no defaults in code).
#   MAX_POOL_SIZE: one request uses up to 3 connections at once, so 20 serves ~7 concurrent requests
#   MIN_POOL_SIZE: connections kept warm      MAX_CONNECTING: new connections opened at the same time
#   timeouts in milliseconds: close idle connections / wait for a free one / find the server / stalled socket
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_CONNECTING=2
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
# On Vercel: set every key of this file in Project → Settings → Environment Variables (MONGO_URI = your
# Atlas connection string; CORS_ORIGINS = the frontend's URL, e.g. https://note-taking-app.vercel.app).
# Serverless instances each open their own pool, so a small MONGO_MAX_POOL_SIZE (e.g. 5) suits Vercel.
# Browser origins allowed to call the API directly (CORS), comma separated; "*" allows any
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Email and password of the admin in bootstrap/user.json (referenced there as ${ADMIN_EMAIL} / ${ADMIN_PASSWORD})
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
